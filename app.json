{
  "expo": {
    "name": "sol-perp-asset-screen",
    "slug": "sol-perp-asset-screen",
    "owner": "deeksharungta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deeksharungta.solperp"
    },
    "android": {
      "package": "com.deeksharungta.solperp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2f08d1c0-3f3a-482c-8d37-6fc4a76bf753"
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "SFProRounded",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SF-Pro-Rounded-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SF-Pro-Rounded-Semibold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/SF-Pro-Rounded-Bold.otf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
